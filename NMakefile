CC = cl
LINK = link

CFLAGS = /nologo /std:c17 /W4 /O2 /Z7 /Iinclude /D_CRT_SECURE_NO_WARNINGS

SHARED = build\rnt.dll
IMPORT = build\rnt.lib
OBJECTS = build\channel.obj build\kernel.obj build\lifecycle.obj \
	build\plug.obj build\protocol.obj build\schema.obj build\session.obj build\wire.obj
HEADERS = include\channel.h include\internal.h include\rnt.h \
	include\rnt_kernel.h include\wire.h
TESTS = build\tests\wire.exe build\tests\kernel.exe build\tests\lifecycle.exe \
	build\tests\channel.exe build\tests\protocol.exe build\tests\sessions.exe
FUZZ_SECONDS = 60

all: $(SHARED)

$(SHARED): $(OBJECTS) NMakefile
	$(LINK) /nologo /DLL /DEBUG /INCREMENTAL:NO /OUT:$@ /IMPLIB:$(IMPORT) $(OBJECTS)

$(OBJECTS): $(HEADERS) NMakefile

{src}.c{build}.obj::
	@if not exist build mkdir build
	$(CC) $(CFLAGS) /DRNT_BUILD /c /Fobuild\ $<

test: $(TESTS)
	!$**

# Tests link the objects to reach private functions.
$(TESTS): tests\check.h tests\plugged.h $(HEADERS) $(OBJECTS)

{tests}.c{build\tests}.exe:
	@if not exist build\tests mkdir build\tests
	$(CC) $(CFLAGS) /Isrc /Fobuild\tests\ /Fe$@ $< $(OBJECTS)

fuzz:
	@if not exist build\fuzz\corpus mkdir build\fuzz\corpus
	$(CC) /nologo /std:c17 /Zi /Iinclude /D_CRT_SECURE_NO_WARNINGS \
		/fsanitize=address /fsanitize=fuzzer /Fobuild\fuzz\ \
		/Febuild\fuzz\decode.exe src\*.c tests\fuzz\decode.c
	build\fuzz\decode.exe -max_len=65536 -max_total_time=$(FUZZ_SECONDS) \
		build\fuzz\corpus

clean:
	@if exist build rmdir /s /q build
