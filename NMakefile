# NMakefile: building with MSVC, from a Developer Command Prompt.
#   nmake /f NMakefile         builds build\rnt.dll, along with its
#                              import library build\rnt.lib
#   nmake /f NMakefile test    builds and runs the tests
# NMake has no wildcards for this, so a new source or test is listed
# here by hand.

CC = cl
LINK = link

CFLAGS = /nologo /std:c17 /W4 /O2 /Z7 /Iinclude /D_CRT_SECURE_NO_WARNINGS

SHARED = build\rnt.dll
IMPORT = build\rnt.lib
OBJECTS = build\channel.obj build\lifecycle.obj build\protocol.obj \
	build\session.obj build\wire.obj
HEADERS = include\channel.h include\internal.h include\rnt.h include\wire.h
TESTS = build\tests\start.exe

all: $(SHARED)

$(SHARED): $(OBJECTS) NMakefile
	$(LINK) /nologo /DLL /DEBUG /INCREMENTAL:NO /OUT:$@ /IMPLIB:$(IMPORT) $(OBJECTS)

$(OBJECTS): $(HEADERS) NMakefile

{src}.c{build}.obj::
	@if not exist build mkdir build
	$(CC) $(CFLAGS) /DRNT_BUILD /c /Fobuild\ $<

# Runs every test program, stopping at the first that fails.
test: $(TESTS)
	!$**

# Tests link the objects themselves, so they reach what the DLL keeps
# hidden, and run without searching for it.
$(TESTS): tests\check.h $(HEADERS) $(OBJECTS)

{tests}.c{build\tests}.exe:
	@if not exist build\tests mkdir build\tests
	$(CC) $(CFLAGS) /Isrc /Fobuild\tests\ /Fe$@ $< $(OBJECTS)

clean:
	@if exist build rmdir /s /q build
